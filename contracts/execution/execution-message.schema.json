{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teamflow:execution-message:v1",
  "title": "Execution message v1",
  "description": "Execution envelope v1 with claim, heartbeat, checkout, portable checkpoints/results and optional cited memory/confirmed parent transfer.",
  "type": "object",
  "required": [
    "schemaVersion",
    "executionId",
    "taskId",
    "organizationId",
    "projectId",
    "workerId",
    "leaseToken",
    "leaseExpiresAt",
    "deadlineAt",
    "attempt",
    "snapshot",
    "limits"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "executionId": {
      "type": "string",
      "format": "uuid"
    },
    "taskId": {
      "type": "string",
      "format": "uuid"
    },
    "organizationId": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "workerId": {
      "type": "string",
      "format": "uuid"
    },
    "leaseToken": {
      "type": "string",
      "format": "uuid"
    },
    "leaseExpiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "deadlineAt": {
      "type": "string",
      "format": "date-time"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "snapshot": {
      "type": "object",
      "required": [
        "title",
        "description",
        "acceptanceCriteria",
        "version"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "version": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "maxDurationSeconds",
        "maxAttempts",
        "maxSteps",
        "maxCostUsd"
      ],
      "properties": {
        "maxDurationSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "maxSteps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "maxCostUsd": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100
        }
      }
    },
    "repository": {
      "type": [
        "object",
        "null"
      ]
    },
    "agentProfileId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "checkpoint": {
      "type": [
        "object",
        "null"
      ]
    },
    "memory": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "urn:teamflow:context-bundle:v1"
        }
      ]
    },
    "transfer": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "urn:teamflow:portable-transfer:v1"
        }
      ]
    }
  }
}
